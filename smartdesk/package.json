{
  "name": "smartdesk",
  "version": "0.1.0",
  "description": "智伴桌面 - 方向 A 桌面预览原型",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "pack": "electron-vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.smartdesk.companion",
    "productName": "智伴桌面",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "koffi": "^3.2.1",
    "lucide-react": "^1.0.0",
    "onnxruntime-node": "^1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
